---
import { project } from "../data/project";

const links = [
  { href: "#findings", label: "Findings" },
  { href: "#method",   label: "Method" },
  { href: "#results",  label: "Results" },
  { href: "#merging",  label: "Merging" },
  { href: "#models",   label: "Models" },
  { href: "#paper",    label: "Paper" },
];
---
<header class="nav">
  <div class="nav__inner wrap">
    <a class="nav__brand" href="#top">
      <span class="nav__mark" aria-hidden="true"></span>
      ClimateModernBERT
    </a>

    <nav class="nav__links" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav__right">
      <a class="nav__icon" href={project.links.github} aria-label="GitHub repository" rel="noopener">
        <svg viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
      <button class="nav__icon" id="theme-toggle" type="button" aria-label="Toggle colour theme">
        <svg class="ico-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="ico-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav__inner {
    display: flex; align-items: center; gap: 1rem;
    height: 3.5rem;
  }
  .nav__brand {
    display: inline-flex; align-items: center; gap: .55rem;
    font-weight: 660; font-size: .95rem; letter-spacing: -.01em;
    color: var(--fg); text-decoration: none; margin-right: auto;
  }
  .nav__mark {
    width: 15px; height: 15px; border-radius: 4px; flex: none;
    background: linear-gradient(135deg, var(--c-a), var(--c-f) 55%, var(--c-s));
  }
  .nav__links { display: none; gap: 1.25rem; }
  .nav__links a {
    color: var(--fg-muted); text-decoration: none; font-size: .875rem; font-weight: 500;
  }
  .nav__links a:hover { color: var(--accent); }
  @media (min-width: 900px) { .nav__links { display: flex; } }

  .nav__right { display: flex; align-items: center; gap: .3rem; }
  .nav__icon {
    display: grid; place-items: center;
    width: 2rem; height: 2rem; padding: 0;
    border: 1px solid transparent; border-radius: 8px;
    background: none; color: var(--fg-muted); cursor: pointer;
  }
  .nav__icon:hover { color: var(--accent); border-color: var(--line); }

  .ico-moon { display: none; }
  :global(:root[data-theme="dark"]) .ico-moon { display: block; }
  :global(:root[data-theme="dark"]) .ico-sun { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .ico-moon { display: block; }
    :global(:root:not([data-theme="light"])) .ico-sun { display: none; }
  }
</style>

<script>
  const btn = document.getElementById("theme-toggle");
  btn?.addEventListener("click", () => {
    const root = document.documentElement;
    const dark =
      root.dataset.theme === "dark" ||
      (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
    const next = dark ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("cmb-theme", next); } catch (e) { /* storage blocked */ }
  });
</script>
