{
  "tasks": {
    "wximpactbench": {
      "type": "multilabel",
      "dataset_name": "Michaelyya/wximpactbench-1386",
      "text_column": "text",
      "impact_columns": [
        "infrastructural_impact",
        "political_impact",
        "financial_impact",
        "ecological_impact",
        "agricultural_impact",
        "human_health_impact"
      ]
    },
    "water_forest_biodiversity_nature": {
      "type": "multilabel",
      "dataset_name": "ESGBERT/WaterForestBiodiversityNature_2200",
      "text_column": "text",
      "impact_columns": [
        "Water",
        "Forest",
        "Biodiversity",
        "Nature"
      ]
    },
    "climate_detection": {
      "type": "binary_numeric",
      "dataset_name": "climatebert/climate_detection",
      "text_column": "text",
      "label_column": "label"
    },
    "netzero_reduction": {
      "type": "multiclass",
      "dataset_name": "climatebert/netzero_reduction_data",
      "text_column": "text",
      "label_column": "target",
      "num_classes": 3,
      "class_names": ["none", "net-zero", "reduction"]
    },
    "environmental_claims": {
      "type": "binary_numeric",
      "dataset_name": "climatebert/environmental_claims",
      "text_column": "text",
      "label_column": "label"
    },
    "tcfd_recommendations": {
      "type": "multiclass",
      "dataset_name": "climatebert/tcfd_recommendations",
      "text_column": "text",
      "label_column": "label",
      "num_classes": 5,
      "class_names": ["none", "metrics", "strategy", "risk", "governance"]
    },
    "climate_sentiment": {
      "type": "multiclass",
      "dataset_name": "climatebert/climate_sentiment",
      "text_column": "text",
      "label_column": "label",
      "num_classes": 3,
      "class_names": ["risk", "neutral", "opportunity"]
    },
    "climate_commitments_actions": {
      "type": "binary_numeric",
      "dataset_name": "climatebert/climate_commitments_actions",
      "text_column": "text",
      "label_column": "label"
    },
    "climate_specificity": {
      "type": "binary_numeric",
      "dataset_name": "climatebert/climate_specificity",
      "text_column": "text",
      "label_column": "label"
    },
    "clim_retrieve": {
      "type": "retrieval_binary_classification",
      "local_data_path": "/path/to/xxx/ClimRetrieve_ReportLevel_V1.csv",
      "query_column": "question",
      "text_column": "paragraph",
      "label_column": "relevance",
      "relevance_threshold": 1,
      "num_classes": 2,
      "class_names": ["not_answerable", "answerable"]
    }
  },

  "defaults": {
    "base_model_path": "xxx/CMB_Soup_A_F_S",
    "base_save_dir": "/path/to/xxx/finetuned_CMB_Soup_A_F_S",
    "benchmark_output_dir": "/path/to/xxx/benchmark_results/finetuned_CMB_Soup_A_F_S",
    "training": {
      "learning_rate": 4e-5,
      "num_train_epochs": 10,
      "per_device_train_batch_size": 32,
      "per_device_eval_batch_size": 16,
      "weight_decay": 0.01,
      "gradient_accumulation_steps": 2,
      "max_length": 512
    }
  }
}
